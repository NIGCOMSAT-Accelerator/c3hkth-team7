# Frontend environment — copy to .env.local
#
#   cp .env.example .env.local
#
# SHELTER_* are SERVER-ONLY. They are read inside Server Components and Server
# Actions and are never bundled into client JavaScript. Do not rename them to
# NEXT_PUBLIC_* — SHELTER_API_KEY authorises subscriber registration and
# satellite broadcasts.

# Where the FastAPI backend is reachable from the Next.js server.
# Local:            http://localhost:8000
# Docker compose:   http://api:8000
SHELTER_API_URL=http://localhost:8000
SHELTER_API_PREFIX=/shelter/v1/api

# Must match API_KEY in the backend .env. Leave blank if the backend has none.
SHELTER_API_KEY=

# Public — safe to expose. Used for canonical URLs and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
