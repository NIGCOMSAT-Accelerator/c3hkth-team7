# Frontend environment — copy to .env.local
#
#   cp .env.example .env.local
#
# SHELTER_* are SERVER-ONLY. They are read inside Server Components and Server
# Actions and are never bundled into client JavaScript. Do not rename them to
# NEXT_PUBLIC_* — SHELTER_API_KEY authorises subscriber registration and
# satellite broadcasts.

# Where the FastAPI backend is reachable from the Next.js server.
# Local:            http://localhost:8000
# Docker compose:   http://api:8000
SHELTER_API_URL=http://localhost:8000
SHELTER_API_PREFIX=/shelter/v1/api

# A scoped service-account key, minted with:
#
#     make iam-service-account NAME=local-frontend EMAIL=you@example.com
#
# It is printed ONCE and hashed at rest, so copy it immediately. It carries
# platform:subscribers:write + platform:read + platform:assess and deliberately
# NOT platform:broadcast — a leak of this file cannot page a district.
#
# This no longer needs to match API_KEY in the backend .env: that was the old
# shared key, which granted every write endpoint including broadcast.
#
# The backend runs without a key in development; the FRONTEND needs one, or
# /places/* returns 401 and the area picker cannot resolve a plot.
SHELTER_API_KEY=

# Public — safe to expose. Used for canonical URLs and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
