# =============================================================================
# SHELTER — environment template
#
#   cp .env.example .env
#
# Every key here is read by code. There are no decorative settings — a test
# (tests/test_config.py) fails the build if one is ever added.
#
# The service starts with none of the credentials set. Each one gates exactly
# one capability, and a missing one degrades that capability rather than
# breaking the run:
#
#   No ANTHROPIC_API_KEY   -> advisories come from the built-in template
#   No channel credentials -> that channel is skipped, the others still deliver
#   No model weights       -> inference falls back to threshold heuristics
#   No optional EO key     -> that source drops out of its failover chain
#
# All Earth Observation sources are free and open. Nothing here requires a paid
# or proprietary geospatial platform.
#
# ---------------------------------------------------------------------------
# Container image — where the stack pulls from
# ---------------------------------------------------------------------------
# Leave both UNSET for local development: compose builds from ./backend and tags the
# result `shelter-api:latest`, which is what a fresh clone needs.
#
# Set them to run a PUSHED image instead — the deployment path, and the reason this
# exists:
#
#     SHELTER_IMAGE=ghcr.io/zerorate/shelter-api
#     SHELTER_TAG=v1.0.0
#
#     docker compose pull
#     docker compose up -d --no-build
#
# All three app services (api, worker, worker-analyst) share this reference. They are
# one image with three roles, selected by the entrypoint's first argument — so a pull
# fetches one image, not three copies, and an api/worker version skew is impossible.
#
# ## Why this matters for the GeoIP database
#
# `backend/data/city.mmdb` (DB-IP City Lite) is gitignored but BAKED INTO THE IMAGE.
# So the workflow is: run `make geoip` once on a machine that has it, `make release`,
# and every deployment that pulls the image resolves IP addresses to city names with
# no licence key, no runtime download and no third-party request. A machine without
# the database still builds a working image — `iam/geo.py` degrades to showing raw IPs.
SHELTER_IMAGE=
SHELTER_TAG=

# ---------------------------------------------------------------------------
# The web portal (compose `--profile ui`)
# ---------------------------------------------------------------------------
#
# Read by docker-compose.yml, NOT by the backend — pydantic never sees these.
#
#     docker compose --profile ui up -d --build
#
# FRONTEND_PORT: the host port the portal binds. 3000 is the commonest occupied port on a
# developer machine (`next dev`, Grafana, Dokploy's own UI), and a bind clash aborts the whole
# `up` with an error naming Docker rather than the conflict. Change it here instead.
FRONTEND_PORT=3000

# The credential the PORTAL presents to the API. Must be a scoped service-account key
# (`shltky…`), which you mint after the stack is up:
#
#     make iam-service-account NAME=local-frontend EMAIL=you@example.com
#
# `lib/api.ts` chooses its header by PREFIX: `shltky…` goes as X-SHELTER-API-Key, anything else
# as the deprecated X-SHELTER-Key — which is refused once IAM is configured. With the wrong kind
# of key, sign-in works (that uses the session cookie) and then the alert feed, Monitored Areas
# and the area picker all return 401. Blank is fine to start: the portal loads and signs in, and
# only those pages are empty.
SHELTER_API_KEY=

# Baked into the frontend image at BUILD time. NEXT_PUBLIC_* is inlined by Next.js at compile
# time, so it cannot be changed by restarting the container — a rebuild is required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Written by `make release` so the next one defaults to the same coordinates. Not read by
# the application or by compose — they exist so an interactive release does not ask the
# same four questions every time.
SHELTER_REGISTRY_HOST=
SHELTER_ORG=
SHELTER_REPO=

# -----------------------------------------------------------------------------
# WHAT TO FILL IN FIRST (everything else has a working default)
#
#   Nothing.            The pipeline runs end-to-end with this file unchanged,
#                       using only the keyless sources.
#   ANTHROPIC_API_KEY   Biggest single upgrade — advisories in the subscriber's
#                       own language instead of English templates.
#   One channel         TELEGRAM_BOT_TOKEN is the fastest to obtain and needs
#                       no template approval.
#   API_KEY             Required before any public deployment.
#
# -----------------------------------------------------------------------------
# EO DATA CREDENTIALS — every one is OPTIONAL and FREE
#
# Verified against live endpoints 2026-08-08; full audit in
# docs/dataset-source-audit.md. Each of these ADDS A FALLBACK to a chain whose
# primary source is already keyless, so none of them gates a feature.
#
# In descending order of value:
#
#   1. NASA_EARTHDATA_TOKEN     urs.earthdata.nasa.gov/users/new -> Generate Token
#                               Best ratio here: one free account covers GPM IMERG
#                               today, plus MODIS / SMAP / SRTM if we add them.
#
#   2. COPERNICUS_CLIENT_ID     dataspace.copernicus.eu -> Dashboard -> OAuth client
#      COPERNICUS_CLIENT_SECRET Second imagery catalogue. Anonymous search already
#                               works for open collections, so this is resilience.
#
#   3. ERA5_CDS_KEY             cds.climate.copernicus.eu -> profile -> API token
#                               Last rainfall fallback; three sources answer first.
#
#   4. PLANETARY_COMPUTER_API_KEY  planetarycomputer.microsoft.com/account/request
#                               VERIFIED UNNECESSARY — search and SAS signing both
#                               returned HTTP 200 with no key. Raises rate limits.
#
# DO NOT create an AWS account for Landsat. The bucket the hackathon brief links
# (registry.opendata.aws/usgs-landsat) is Requester Pays: the licence is free but
# reads bill YOUR account and cannot be anonymous. Element84 serves the same
# `landsat-c2-l2` collection keyless with free egress.
# =============================================================================


# =============================================================================
# APP
# =============================================================================
APP_NAME=SHELTER
# Advertised in the root document, the OpenAPI schema and every outbound webhook's
# `api_version`. Receivers key their parser off it, so it is a contract.
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Every route, the Swagger UI (/docs) and the OpenAPI schema live under this prefix,
# so an SSL reverse proxy needs exactly one location block for the whole service.
API_PREFIX=/shelter/v1/api
CORS_ORIGINS=http://localhost:3000,https://shelter.zerorate.io
PUBLIC_SITE_URL=https://shelter.zerorate.io
# Public base URL of the API, if it is served from a different host than the portal —
# which it is in the target shape (frontend on Netlify, backend behind its own reverse
# proxy). Used in onboarding email to link an aggregator at the OpenAPI spec and the
# Swagger UI, both of which are UNGATED so a partner can generate a client before they
# have a key. Falls back to PUBLIC_SITE_URL for a single-host install.
API_BASE_URL=

# Shared secret for write endpoints, sent as the `X-SHELTER-Key` header.
# Leave blank locally. SET THIS IN PRODUCTION — without it, anyone can register
# subscribers and trigger satellite broadcasts.
API_KEY=

# --- Serving (read by docker-entrypoint.sh, not by app/config.py) -------------
# Uvicorn worker processes. Deliberately 1: `lifespan` starts the watch loop, so N
# workers would run N schedulers and scan every area N times per cycle. The
# entrypoint REFUSES WEB_CONCURRENCY>1 while SCHEDULER_ENABLED=true rather than
# letting subscribers get duplicate alerts.
#
# Scale the API with replicas behind the reverse proxy instead — that scales across
# hosts and keeps the scheduler-singleton property explicit. Raising this is only
# valid on a read-only replica with SCHEDULER_ENABLED=false.
#
# Gunicorn is not used: under ASGI it only supervises uvicorn workers, so it adds a
# dependency for process management uvicorn already has, and every extra worker
# imports torch + GDAL (~400-600 MB resident before serving a request).
WEB_CONCURRENCY=1
# Trusted proxy sources for X-Forwarded-*. '*' trusts the immediate peer, correct
# when only the reverse proxy can reach port 8000. Narrow it if that is not true.
FORWARDED_ALLOW_IPS=*
# Seconds uvicorn waits for in-flight requests on SIGTERM before dropping them.
GRACEFUL_TIMEOUT=30


# =============================================================================
# REDIS / DRAGONFLY — queue on db0, cache on db1
#
# Two logical databases on one instance:
#
#   db0   job streams + dead-letter. Durable, never evicted.
#   db1   cache. Every key disposable, every write carries a TTL.
#
# IMPORTANT: eviction policy is per-INSTANCE, not per-database. Enabling
# eviction to protect db1 would also let the server drop db0 stream entries —
# i.e. silently lose a queued satellite scan. So eviction stays OFF, and
# app/store/cache.py requires an explicit TTL on every write instead. Bounded
# growth is the caller's job, not the evictor's.
#
# Works unchanged against Dragonfly (Redis wire protocol). If you run
# Dragonfly, make sure it was started with --dbnum=2 or higher, or SELECT 1
# fails and every cache call errors.
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CACHE_PREFIX=shelter:cache
CACHE_DEFAULT_TTL_SECONDS=900
CACHE_ASSESSMENT_TTL_SECONDS=172800
QUEUE_STREAM_PREFIX=shelter
QUEUE_CONSUMER_GROUP=shelter-workers
QUEUE_BLOCK_MS=5000
QUEUE_MAX_RETRIES=3


# =============================================================================
# POSTGRESQL — system of record (PostGIS + pgvector + TimescaleDB)
#
# Redis is a queue and a cache in front of this. This is the durable copy.
#
# Three extensions, each doing a job nothing else can:
#   postgis      GiST-indexed ST_Intersects — "which subscribers sit inside this
#                flood footprint?" as an index lookup, not a full scan.
#   vector       Embeddings stored beside the rows they describe, so retrieval
#                can filter spatially AND semantically in one query.
#   timescaledb  Assessments are append-only; the hypertable partitions them by
#                time so keeping full history stays cheap.
#
# The compose file uses timescale/timescaledb-ha, which ships all three.
# =============================================================================
POSTGRES_DSN=postgresql://shelter:shelter@localhost:5432/shelter
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_COMMAND_TIMEOUT=30.0

# Apply pending migrations at startup. Right for compose and local work. For a
# multi-replica deployment set false and migrate as an explicit release step,
# otherwise replicas race each other.
POSTGRES_AUTO_MIGRATE=true

TIMESCALE_CHUNK_INTERVAL_DAYS=7

# Must match the embedding model's output width. Changing this needs a
# migration — the column type carries the dimension.
EMBEDDING_DIMENSIONS=1536


# =============================================================================
# OBJECT STORAGE — MinIO / any S3-compatible
#
# Unstructured blobs: advisory voice notes (mp3), cached imagery crops,
# operator exports. Self-hosting MinIO keeps the same sovereignty property the
# NIGCOMSAT broadcast layer exists for — no third party between the warning and
# the recipient.
#
# Local compose credentials are shelter / shelter-dev-secret. CHANGE THEM in
# any deployment: these buckets hold subscriber-addressable audio.
# =============================================================================
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=false
S3_REGION=us-east-1
S3_BUCKET_AUDIO=shelter-audio
S3_BUCKET_IMAGERY=shelter-imagery
S3_BUCKET_EXPORTS=shelter-exports

# Presigned URL lifetime. Short on purpose: an audio link in a Telegram message
# only has to survive the download, not the conversation.
S3_PRESIGN_TTL_SECONDS=3600

S3_AUTO_CREATE_BUCKETS=true


# =============================================================================
# SATELLITE IMAGERY — STAC catalogues
#
# Searched in failover order: Element84 (anonymous, fast) -> Copernicus Data
# Space -> Planetary Computer. All three work with no credentials.
# =============================================================================
STAC_EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
STAC_COPERNICUS_URL=https://catalogue.dataspace.copernicus.eu/stac
STAC_PLANETARY_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Collection IDs genuinely differ between catalogues serving the SAME
# satellite. Copernicus uses upper-case mission names; using the Element84
# slug there returns an empty result set with no error.
COLLECTION_S2=sentinel-2-l2a
COLLECTION_S1=sentinel-1-rtc
# Copernicus Sentinel collection IDs — EMPTY, deliberately.
#
# This STAC endpoint serves no Sentinel data. Verified 2026-08-10: /stac/collections
# returns ccm-optical, ccm-sar and eight CLMS burnt-area products, and a Sentinel
# search returns HTTP 400 CollectionInQuerryDoesNotExist. Sentinel access at
# Copernicus is via OData/OpenSearch, a different protocol needing its own adapter.
#
# Empty means catalogs.chain_for skips the rung, so no scan wastes a request that
# cannot succeed. Set these if you have the OData adapter, or if Copernicus later
# publishes Sentinel over STAC — the rung then works with no code change.
COLLECTION_S2_COPERNICUS=
COLLECTION_S1_COPERNICUS=
COLLECTION_DEM=cop-dem-glo-30
COLLECTION_WORLDCOVER=esa-worldcover
# Landsat 8/9 Collection-2 Level-2, on Planetary Computer. Keyless.
#
# The SECOND optical sensor, and it is load-bearing in southern Nigeria. Measured
# over 90 days of rainy season: Sentinel-2 returned ZERO scenes under 40% cloud at
# Ikorodu and Yenagoa, while Landsat returned three usable ones at Ikorodu. Different
# platform and overpass time, so it sees through gaps S2 cannot.
#
# 30 m / 16-day against S2's 10 m / 5-day, so it supplements rather than replaces:
# `_best_optical` picks the least-cloudy scene across both and stays on S2 where it can.
COLLECTION_LANDSAT=landsat-c2-l2
# JRC Global Surface Water — permanent-water baseline (Planetary Computer, keyless).
COLLECTION_SURFACE_WATER=jrc-gsw

# --- Copernicus Data Space (optional) ---
# Free account at https://dataspace.copernicus.eu -> create an OAuth client.
# Anonymous search works for open collections; credentials unlock the rest.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# --- Planetary Computer (optional) ---
# Asset hrefs point at Azure Blob and are SAS-signed automatically. The key is
# only needed to raise rate limits / unlock restricted collections.
# Free at https://planetarycomputer.microsoft.com/account/request
PLANETARY_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1
PLANETARY_COMPUTER_API_KEY=


# =============================================================================
# RAINFALL — tried in this order, first that answers wins
#
# Only ClimateSERV GEFS is a real FORECAST. The rest are observational and
# supply "antecedent wetness" (how saturated the ground already is), which the
# Oracle weights lower and flags in the advisory. Nothing is ever invented.
# =============================================================================

# --- 1. SERVIR ClimateSERV — keyless, fronts CHIRPS + GEFS ---
# This is also how CHIRPS is reached; there is no separate CHIRPS key.
CLIMATESERV_URL=https://climateserv.servirglobal.net/api
CLIMATESERV_DATATYPE=0              # CHIRPS observed precipitation
# --- Short-range rainfall FORECAST (rung 1) — the only forward-looking source ---
#
# `forecast_available` separates "the ground is already wet" from "more rain is
# coming", and only the second supports a FORWARD flood warning. That flag was
# permanently False: CLIMATESERV_FORECAST_DATATYPE defaulted to 35, labelled GEFS,
# but ClimateSERV serves NO GEFS — getClimateScenarioInfo lists only CCSM4/CFSv2,
# and 35 is rejected outright with progress -1. So every advisory was antecedent-only
# and took the 0.75 no-forecast confidence penalty for a configuration error.
#
# Open-Meteo is a keyless JSON facade over NOAA GFS/GEFS (`gfs_seamless`) — the model
# the brief intends. JSON rather than GRIB2 keeps eo/rainfall.py free of
# cfgrib/eccodes, the same constraint that leaves the ERA5 rung declining.
#
# Verified live 2026-08-11, 7-day daily precipitation (mm):
#   Kano    [15.0, 2.3, 11.5, 7.5, 5.0, 6.9, 14.2]
#   Yenagoa [6.3, 1.5, 17.1, 10.5, 8.6, 5.7, 5.1]
#   Ikorodu [0.1, 0.8, 0.4, 0.1, 0.5, 1.2, 0.3]
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
FORECAST_MODEL=gfs_seamless
CLIMATESERV_POLL_ATTEMPTS=12
CLIMATESERV_POLL_INTERVAL_SECONDS=2.0

# --- 2. NASA GPM IMERG (optional) ---
# Free token: https://urs.earthdata.nasa.gov -> Generate Token
# --- GPM IMERG (rung 3) — the ONLY antecedent source that is actually current ---
#
# IMERG daily late-run publishes with a ~2-DAY LAG. CHIRPS (rung 2) is a reanalysis
# product published ~6 weeks in arrears. So this is the only rung that answers "how
# wet is the ground NOW", which is the question a flood warning depends on. CHIRPS
# stays ahead of it in the chain only because CHIRPS needs no credential.
#
# Requires NASA_EARTHDATA_TOKEN *and* the `NASA GESDISC DATA ARCHIVE` application
# authorised at urs.earthdata.nasa.gov -> Applications -> Authorized Apps. A token
# alone returns 401 — that is an account action, not a configuration error.
#
# Verified live 2026-08-11 once authorised: Kano 15.6 mm / 7 days, Yenagoa 89.8 mm.
# The delta is correct — the Niger Delta is far wetter than the Sahel.
#
# Granule filenames are NOT constructible: the processing suffix advances without
# notice (V07B -> V07C was observed), so CMR is asked for the exact OPeNDAP href.
CMR_SEARCH_URL=https://cmr.earthdata.nasa.gov/search
GPM_IMERG_SHORT_NAME=GPM_3IMERGDL
GPM_IMERG_VERSION=07
# Expected OPeNDAP host. Read as a GUARD: a granule href CMR publishes from any other
# host is skipped, so an upstream index change cannot silently redirect authenticated
# reads. Note this is NOT gpm1.gesdisc.eosdis.nasa.gov — that host 404s on the product
# path and times out at the root.
IMERG_OPENDAP_HOST=opendap.earthdata.nasa.gov
NASA_EARTHDATA_TOKEN=

# --- 3. Copernicus ERA5 reanalysis (optional) ---
# Free key: https://cds.climate.copernicus.eu -> your profile -> API token
ERA5_CDS_URL=https://cds.climate.copernicus.eu/api
ERA5_DATASET=reanalysis-era5-single-levels
ERA5_CDS_KEY=


# =============================================================================
# EXPOSURE — who and what is inside the footprint
#
# All keyless. These turn a hazard into a consequence.
# =============================================================================

# --- Population (WorldPop zonal-stats REST API) ---
WORLDPOP_API_URL=https://api.worldpop.org/v1
WORLDPOP_DATASET=wpgppop
WORLDPOP_YEAR=2020

# --- Settlements & health facilities (OpenStreetMap Overpass) ---
# The public instance is UNRELIABLE. Measured 2026-08-10 from a Nigerian AOI query:
#
#   overpass-api.de          0/3 successful   (504 and 406)
#   overpass.kumi.systems    2/3 successful
#   overpass.private.coffee  0/3 successful
#
# `eo/exposure.py` catches the failure and returns 0, and `_exposure_term` treats
# unknown exposure as unknown rather than "nobody lives there" — so this degrades
# honestly. But OSM is the ONLY infrastructure source, so a dead host means no
# building or road counts at all. Switch to the kumi mirror if the default keeps
# timing out; both speak the identical API.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter


# =============================================================================
# ADMINISTRATIVE BOUNDARIES — State / LGA / Ward
#
# Both sources are KEYLESS. Nothing to register.
#
# ## Why this matters more than it looks
#
# Fahis — the verification agent — searches outside reporting BY PLACE NAME, built
# from admin1/admin2 and deliberately never from the subscriber's own plot label
# ("My Irri Palm Fruit Plantation" appears in no news report). An AOI with no
# administrative name is therefore UNVERIFIABLE: the accountability loop has nothing
# to search for, and returns UNVERIFIED for want of a query rather than for want of
# reporting.
#
# It also lets the portal offer a State/LGA/Ward picker instead of a map, which is
# the difference between a form a smallholder completes on a phone and one they abandon.
#
# ## Three tiers, and each exists because the tier above has a real hole
#
#   1. GRID3 wards  State/LGA/Ward. 5,872 wards — but only 24 of 37 states.
#                   LAGOS IS ABSENT (verified: state='Lagos' returns count 0).
#                   Carries alternate spellings, which a name search needs:
#                   "Ode Lemo" / "Ode -Lemo" / "Odelemo" are one ward.
#   2. GRID3 LGA    State/LGA. All 774 LGAs, all 37 states. This is the tier that
#                   covers Lagos — without it a third of Nigeria resolves to nothing.
#   3. geoBoundaries Country level, every country. ADM1/ADM2 answer for Nigeria;
#                   ADM3 returns 404, which is why GRID3 is the ward source.
#
# Measured end to end: Ikorodu -> Lagos/Ikorodu (tier 2), Kano -> Kano/Ungogo/Tudun
# Fulani (tier 1), Yenagoa -> Bayelsa/Ogbia/Imiringi-Ward 8 (tier 1).
#
# Resolution NEVER overwrites a value the subscriber or aggregator supplied, and never
# fails a registration — an unresolved AOI is monitored exactly as well, just harder
# to verify.
# =============================================================================
# Set false to keep whatever the subscriber typed and skip resolution entirely.
ADMIN_RESOLUTION_ENABLED=true
GRID3_BASE_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services
GRID3_WARDS_SERVICE=GRID3_NGA_operational_wards_v3_0
GRID3_LGA_SERVICE=NGA_LGA_Boundaries_2
GEOBOUNDARIES_BASE_URL=https://www.geoboundaries.org/api/current

# --- Land cover (ESA WorldCover) ---
# Class codes used to count REAL cropland hectares instead of estimating them.
WORLDCOVER_CROPLAND_CLASS=40
WORLDCOVER_WATER_CLASS=80
WORLDCOVER_BUILTUP_CLASS=50

# --- Terrain (Copernicus DEM GLO-30) ---
# A pixel this many metres below the AOI's median elevation counts as
# low-lying — where water collects first.
DEM_LOWLAND_OFFSET_M=3.0

# Pixel grid for the WorldCover / DEM reads. Smaller than the imagery tile
# because these need area statistics, not per-plot detail.
EXPOSURE_TILE_SIZE=256


# =============================================================================
# SOIL — how long standing water persists (ISRIC SoilGrids, keyless)
# =============================================================================
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0
SOILGRIDS_DEPTH=0-5cm
# Clay above this (g/kg) drains slowly, so waterlogging persists and the
# crop-damage window is longer.
SOILGRIDS_HEAVY_CLAY_THRESHOLD=350.0

# --- SMAP soil moisture — the irrigation signal (needs NASA_EARTHDATA_TOKEN) ---
#
# SoilGrids above says what the soil IS; rainfall says what FELL. Neither says how much water is in
# the ground RIGHT NOW, which is the state an irrigate-or-hold call actually turns on. SMAP's L-band
# radiometer measures it directly, through cloud and through canopy.
#
# No key of its own: reuses NASA_EARTHDATA_TOKEN, CMR_SEARCH_URL and IMERG_OPENDAP_HOST from the
# RAINFALL section. The same "NASA GESDISC DATA ARCHIVE" authorisation IMERG needs covers this.
#
# SPL3SMP_E (enhanced 9 km, daily) rather than SPL2SMAP_S (3 km): measured 2026-08-11, the 3 km
# product's newest granule over Nigeria was six weeks old against two days for this one. On a weekly
# irrigation decision, currency beats resolution — and either cell already dwarfs a smallholder plot.
SMAP_SHORT_NAME=SPL3SMP_E


# =============================================================================
# HEALTH — malaria cascade gating (Malaria Atlas Project, keyless)
#
# Standing water only raises transmission where the parasite already
# circulates. Below the threshold, a flood is an agricultural emergency but
# not a public-health one, and the malaria cascade is not asserted.
#
# MAP VERSION-PREFIXES ITS LAYERS and retires the old names, so this is the one
# setting here that goes stale on its own. Read the current name out of the data
# portal's own JS bundle:
#
#   curl -s https://data.malariaatlas.org/ | grep -oE 'chunk-[A-Z0-9]+\.js' \
#     | while read j; do curl -s "https://data.malariaatlas.org/$j"; done \
#     | grep -oE 'PF_PR="[^"]*"'
#
# NOTE (2026-08-12): MAP's GeoServer is returning 504 for every request,
# including the ones its own portal makes. Nothing here can fix that — the
# baseline degrades to unavailable and the Oracle declines to assert the malaria
# cascade, which is the designed behaviour. Set MALARIA_ATLAS_ENABLED=false to
# stop the retry and the warning while the outage lasts.
# =============================================================================
MALARIA_ATLAS_ENABLED=true
MALARIA_ATLAS_URL=https://data.malariaatlas.org/geoserver
MALARIA_ATLAS_WORKSPACE=Malaria
MALARIA_ATLAS_LAYER=202508_Global_Pf_Parasite_Rate
MALARIA_ENDEMIC_THRESHOLD=0.05


# =============================================================================
# INFERENCE
# =============================================================================
TORCH_DEVICE=cpu

# --- Derived-statistics layer ------------------------------------------------
# Each gates one accuracy improvement with a documented non-ML fallback, so
# setting any of these false returns the previous behaviour rather than breaking.
#
# Per-scene Otsu SAR threshold instead of a fixed -16 dB (auto-falls back when a
# scene's histogram is not bimodal).
ADAPTIVE_SAR_THRESHOLD=true
# Subtract JRC permanent water from inundation — the largest false-positive cut.
PERMANENT_WATER_MASKING=true
# HAND/TWI terrain analysis instead of the median-elevation proxy. Cached 30 days.
TERRAIN_ANALYSIS_ENABLED=true
# SPI / Antecedent Precipitation Index alongside raw millimetres.
RAINFALL_STATISTICS_ENABLED=true
# Apply a fitted confidence-calibration curve. Off by default: adopting a curve is
# an operator decision after reading the reliability diagram, not automatic.
CONFIDENCE_CALIBRATION_ENABLED=false
SAR_FLOOD_WEIGHTS=app/ml/weights/sar_flood.pt
CROP_STRESS_WEIGHTS=app/ml/weights/crop_stress.pt
TILE_SIZE=512
# How far back a scene search reaches, in days. NOT per-sensor.
#
# 12 fits Sentinel-2 (5-day) and Sentinel-1 (~6-day) with margin for a missed pass,
# but Landsat revisits every 16 DAYS — at 12 it could never return anything, so the
# second optical sensor would have been live in /health and blind in practice.
# Measured at Ikorodu: days_back=12 gave 0 Landsat scenes, 30 gave one at 29.5% cloud.
#
# 20 covers one Landsat cycle plus a missed pass. Do not widen much further: a scene's
# age bounds how current the reading is, and the selector sorts by cloud with recency
# only as a tie-break — so a wide window lets a clear-but-stale scene beat a fresh one.
MAX_SCENE_AGE_DAYS=20
FORECAST_HORIZON_DAYS=7


# =============================================================================
# ADVISORY GENERATION
#
# Nothing configured -> deterministic English template advisories.
# Configured         -> advisories in each subscriber's language, grounded
#                       strictly in the pipeline's own evidence list.
#
# ADVISORY_PROVIDER selects the path:
#
#   auto       (default) portable path if LLM_BASE_URL is set, else the Anthropic
#              SDK if ANTHROPIC_API_KEY is set, else template.
#   openai     force the portable /v1/chat/completions path. Switch frontier
#              providers with LLM_BASE_URL + LLM_API_KEY and nothing else.
#   anthropic  force the native SDK. Keeps two things the portable path cannot
#              express: server-side fallback (a refusal is re-served by another
#              model inside the same request) and ADVISORY_EFFORT.
#   template   no generation at all.
#
# The template fallback ALWAYS applies, on every provider: no configuration can
# result in a subscriber receiving no advisory.
# =============================================================================
ADVISORY_PROVIDER=auto
ADVISORY_MAX_TOKENS=2000

# --- Portable path (any OpenAI-compatible provider) ---
# Blank falls through to LLM_MODEL, so a single-provider deployment names one
# model, not two.
ADVISORY_MODEL_OPENAI=

# --- Native Anthropic path (optional) ---
ANTHROPIC_API_KEY=
ADVISORY_MODEL=claude-opus-5
ADVISORY_EFFORT=medium


# =============================================================================
# DELIVERY CHANNELS
# =============================================================================

# --- WhatsApp Cloud API ---  https://developers.facebook.com/docs/whatsapp
# NOTE: outside a 24-hour conversation window Meta only delivers *approved
# templates*. Free-form sends return HTTP 200 and are silently dropped. Early
# warnings are unsolicited by definition, so production needs a template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# --- Telegram ---  create a bot with @BotFather. Fastest channel to enable.
TELEGRAM_BOT_TOKEN=

# --- Signal ---  self-hosted signal-cli-rest-api
# Start with: docker compose --profile signal up -d
SIGNAL_API_URL=http://localhost:8080
SIGNAL_SENDER_NUMBER=

# --- Email (SMTP) ---
# Brevo: smtp-relay.brevo.com — a standards-compliant relay on :587 with STARTTLS,
# so no vendor SDK is needed. SMTP_USERNAME is the login shown in Brevo's SMTP & API
# panel (an address, NOT your account email), and SMTP_PASSWORD is the SMTP key
# generated there (NOT your Brevo password).
#
# SMTP_FROM must be a sender Brevo has verified, or every message is rejected at
# submission with a 550 — verify the domain or the single address first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@shelter.zerorate.io
SMTP_USE_TLS=true
# Display name beside the address. Brevo shows it, and an unnamed sender is markedly
# more likely to be filed as spam.
SMTP_FROM_NAME=SHELTER Early Warning
# Where replies go. Brevo's relay address is not a mailbox, so without this a
# subscriber replying to an alert gets a bounce.
SMTP_REPLY_TO=

# --- Transactional email transport -------------------------------------------
# Two ways to reach the same Brevo account, and they fail differently:
#
#   brevo_api  HTTPS POST to /v3/smtp/email. Authenticates with the API key alone,
#              so it is UNAFFECTED by Brevo's sender-IP allow-list, and it returns a
#              messageId for delivery auditing. Verified working: HTTP 201.
#   smtp       The relay on :587. Needs a separate SMTP key AND this host's egress
#              IP on Brevo's permit list. Verified failing from an unlisted host with
#              `535 Authentication failed`, which is why the API is preferred.
#
# auto -> prefer the API when a key is present, else SMTP, else send nothing.
#
# A *forced* provider that is not configured degrades to noop, NOT to the other
# transport. An explicit choice quietly rerouted is worse than mail not being sent,
# because the operator believes it went. Same rule as ADVISORY_PROVIDER.
#   "auto" | "brevo_api" | "smtp" | "noop"
NOTIFICATION_PROVIDER=auto

# Brevo transactional API. The key is the `xkeysib-` one from SMTP & API -> API Keys
# (NOT the `xsmtpsib-` SMTP key, which is a different credential for the relay).
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# Must be a sender Brevo has verified, or every POST is rejected with a 400. Falls
# back to SMTP_FROM when unset.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SHELTER
BREVO_REPLY_TO_EMAIL=
# Tag on every message, so transactional onboarding mail is filterable from alert
# traffic in Brevo's dashboard when diagnosing a delivery complaint.
BREVO_TAG=shelter-transactional

# --- Slack ---  bot token needs chat:write
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#shelter-alerts

# --- Outbound webhooks (subscriber-supplied endpoints) ---
# Receivers must verify the X-SHELTER-Signature HMAC before acting on a payload.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=15

# --- Webhook subscription engine ---------------------------------------------
# The business-integration surface at /shelter/v1/api/webhook, distinct from the
# per-subscriber webhook channel above: businesses running their own AI/intelligence
# jobs on SHELTER output subscribe here and get at-least-once delivery with backoff,
# event filtering and a per-endpoint signing secret.
WEBHOOK_ENGINE_ENABLED=true
# Consecutive failures before an endpoint is auto-disabled. A dead integration would
# otherwise consume retry budget forever while nobody is watching.
WEBHOOK_MAX_CONSECUTIVE_FAILURES=20
# Deliveries retried per scheduler cycle. Bounded so one endpoint with a large
# backlog cannot monopolise a sweep.
WEBHOOK_SWEEP_BATCH_SIZE=50
# Delivery-history retention. Long enough to answer "did you send it last week?",
# short enough that the table stays bounded.
WEBHOOK_HISTORY_RETENTION_DAYS=30

# --- NIGCOMSAT-1R satellite broadcast ---
# The offline last mile: one-way, no consumer internet needed, whole-footprint.
# Fires when every terrestrial channel fails, or at/above the severity below.
NIGCOMSAT_GATEWAY_URL=
NIGCOMSAT_API_KEY=
NIGCOMSAT_BEAM_ID=NIG-1R-KU-WA
NIGCOMSAT_MAX_PAYLOAD_BYTES=280
NIGCOMSAT_ALWAYS_BROADCAST_AT=warning


# =============================================================================
# WEB SEARCH — self-hosted SearXNG
#
# Used by exactly two things: Fahis (ground-truth verification) and Herald chat.
# NEVER by Scout / Analyst / Oracle — web prose in a risk score would break both
# reproducibility and the never-invent-data rule the pipeline is built on.
#
# Self-hosted rather than a hosted API (Tavily etc.) for the same reason Signal
# and MinIO are: every query names a Nigerian district and a hazard, and routing
# that through a US SaaS endpoint cuts against the sovereignty property the
# NIGCOMSAT layer exists to provide.
#
# Blank disables both features cleanly — Fahis records NOT_ATTEMPTED (never
# "refuted"), and chat drops its search tool but still answers from alert data.
#
#   docker run -p 8888:8080 searxng/searxng
#   Enable the JSON format in its settings.yml: search.formats: [html, json]
# =============================================================================
# ---------------------------------------------------------------------
# SEARCH BACKEND FOR FAHIS — the accountability agent
#
# Fahis runs days after a warning and looks for independent confirmation that
# the hazard actually happened. That needs a web search backend, and which one
# is YOUR choice — nothing search-related ships in docker-compose.yml.
#
#   searxng   Self-hosted. Sovereignty-preserving: every query names a Nigerian
#             district and a hazard, and routing that through a US SaaS endpoint
#             cuts against what the NIGCOMSAT layer exists to provide.
#             NOTE: SearXNG's JSON API is OFF by default. A stock instance
#             returns 403 for ?format=json. Enable it in settings.yml:
#                 search:
#                   formats: [html, json]
#
#   tavily    Managed. Nothing to run. Point TAVILY_API_BASE elsewhere for a
#             self-hosted or proxied deployment.
#
#   none      Default. Fahis records NOT_ATTEMPTED — an outage, never a
#             non-finding. The pipeline runs normally; precision is simply
#             unmeasurable until a backend is configured.
#
# The two are NOT interchangeable behind one URL, which the naming invites you
# to assume. SearXNG is `GET /search?q=…&format=json`; Tavily is `POST /search`
# with the key in the JSON body. Verified: a Tavily-shaped POST to SearXNG
# returns an HTML page, ignoring every field in the body.
# ---------------------------------------------------------------------
SEARCH_PROVIDER=none

# --- if SEARCH_PROVIDER=searxng ---
SEARXNG_URL=
# Optional bearer token, when the instance sits behind an authenticating proxy.
SEARXNG_API_KEY=
# SearXNG categories, comma-separated. `news` is the default and it matters:
# measured on a live instance for the same query, `general` returned 29 results
# with ZERO publication dates, while `news` returned 25 with dates on 23.
# Verification asks whether a hazard occurred in a specific window, which is
# unanswerable without dates. `news,general` widens recall at the cost of undated
# results.
SEARCH_CATEGORIES=news

# SearXNG's coarse time filter. OFF, and measured: with it on, the news category
# returned 9 results and ZERO publication dates; with it off, 3 results of which 2
# were dated. It widens the engine set to ones that do not report dates — trading
# the exact signal verification needs. Recency is enforced downstream instead, in
# `fahis._recency` and `_guard_verdict`.
SEARXNG_TIME_RANGE=false
SEARXNG_ENGINES=

# --- if SEARCH_PROVIDER=tavily ---
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com
# `basic` or `advanced`. Basic is enough: Fahis needs to know whether an event
# was reported, not to read the article.
TAVILY_SEARCH_DEPTH=basic

SEARCH_LANGUAGE=en

# Authoritative domains. A `confirmed` verdict requires one of these or a media
# domain — an aggregator alone is not corroboration.
SEARCH_OFFICIAL_DOMAINS=nema.gov.ng,nimet.gov.ng,nihsa.gov.ng,ncdc.gov.ng,fmino.gov.ng,reliefweb.int,who.int,fao.org,unocha.org,fews.net

# Established outlets. Weaker than official, still citable.
SEARCH_MEDIA_DOMAINS=premiumtimesng.com,punchng.com,vanguardngr.com,dailytrust.com,thisdaylive.com,channelstv.com,bbc.com,reuters.com,aljazeera.com

# Extra domains to never cite. Our own site is excluded automatically from
# PUBLIC_SITE_URL; add mirrors that republish our alerts, or verification could
# "confirm" a SHELTER alert by finding SHELTER's own alert.
SEARCH_EXCLUDE_DOMAINS=


# =============================================================================
# LLM TRANSPORT — OpenAI-compatible /v1/chat/completions
#
# THE portable inference path. Serves Fahis adjudication, Herald chat, and
# advisory generation (when ADVISORY_PROVIDER is auto/openai).
#
# Nothing in app/llm/ uses a vendor extension, so switching frontier providers is
# these two variables. A test fails the build if a vendor-specific parameter ever
# appears in that package.
#
#   Provider              LLM_BASE_URL                                              LLM_MODEL
#   --------              ------------                                              ---------
#   OpenAI                https://api.openai.com/v1                                 gpt-4o
#   Anthropic             https://api.anthropic.com/v1                              claude-opus-5
#   Google Gemini         https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.5-pro
#   xAI                   https://api.x.ai/v1                                       grok-4
#   DeepSeek              https://api.deepseek.com/v1                               deepseek-chat
#   Mistral               https://api.mistral.ai/v1                                 mistral-large-latest
#   Groq                  https://api.groq.com/openai/v1                            llama-3.3-70b-versatile
#   Together              https://api.together.xyz/v1                               <model>
#   OpenRouter            https://openrouter.ai/api/v1                              <vendor>/<model>
#   Azure OpenAI          https://<res>.openai.azure.com/openai/v1                  <deployment>
#   vLLM (self-hosted)    http://localhost:8000/v1                                  <model>   (no key)
#   Ollama (self-hosted)  http://localhost:11434/v1                                 llama3.3  (no key)
#   LiteLLM proxy         http://localhost:4000/v1                                  <alias>
#
# Blank disables Fahis adjudication (sources are still recorded for manual
# review), returns 503 from chat, and drops advisories to the template path.
# =============================================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Reasoning depth: "none" | "low" | "medium" | "high", or blank to omit the
# parameter entirely (required for providers that do not support it).
#
# "none" is strongly recommended. A reasoning model spends completion tokens on
# internal thinking before emitting visible text, and that thinking competes with
# the answer for max_tokens — measured at ~1200-2200 tokens with truncation, versus
# 37 tokens and no truncation with thinking off.
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=1500
LLM_MAX_TOOL_ROUNDS=4
LLM_TOOL_RESULT_MAX_CHARS=6000

# --- Provider compatibility ---
# Defaults target the widest support. Change only if your provider rejects a
# request; each of these exists because at least one major provider differs.

# OpenAI's reasoning models (o1, o3, gpt-5 family) reject `max_tokens` and
# require `max_completion_tokens`. Everything else accepts `max_tokens`.
LLM_MAX_TOKENS_PARAM=max_tokens

# Those same reasoning models accept only the default temperature and return 400
# on any explicit value, so it must be omitted rather than set. false omits it.
LLM_SUPPORTS_TEMPERATURE=true

# Structured output negotiation:
#   auto          try json_schema, fall back to json_object, then to prompt-only
#   json_schema   pin to strict schema (OpenAI 4o+, vLLM with guided decoding)
#   json_object   pin to valid-JSON-but-unenforced-shape
#   prompt        no server-side constraint; schema goes in the prompt
# Leave on auto unless you want to skip the probing round trips.
LLM_STRUCTURED_OUTPUT_MODE=auto


# =============================================================================
# FAHIS — agent 5, ground-truth verification
#
# The only source of ground truth in the system. Model weights are absent by
# default and inference falls back to threshold heuristics, so without these
# verdicts there is no way to know whether a WARNING meant anything.
#
# Runs days AFTER delivery, off the main pipeline. It writes to `verifications`
# and `agent_memory` and nowhere else — it never touches an advisory, adjusts a
# severity, or feeds a score.
#
# Its verdicts bias hard toward UNVERIFIED. A flood in a remote LGA may never be
# reported by any indexable source, and reading that silence as "refuted" would
# record correct warnings as false alarms.
# =============================================================================
FAHIS_ENABLED=true

# Wait after the forecast window closes before searching. Local news and agency
# bulletins trail events, so checking immediately finds nothing.
FAHIS_REPORTING_LAG_DAYS=3
FAHIS_SEARCH_WINDOW_DAYS=14
FAHIS_MAX_QUERIES=3
FAHIS_RESULTS_PER_QUERY=6
FAHIS_MAX_SOURCES=10
FAHIS_SNIPPET_MAX_CHARS=800

# Assessments verified per sweep. Bounded so a backlog drains gradually rather
# than flooding a self-hosted SearXNG in one burst.
FAHIS_BATCH_SIZE=20


# =============================================================================
# CHAT — Herald's conversational surface
#
# Lets a subscriber ask why an alert was sent. Session-scoped: every data tool is
# bound to one subscriber at construction, so the model cannot widen its own
# scope. That matters because GET /alerts is currently unauthenticated, and an
# unscoped chat endpoint would be a convenient exfiltration interface.
#
# Hard rule in the prompt AND the tool design: hazard figures come only from the
# subscriber's own assessments. Web search supplies background context and may
# never contribute a number about their hazard.
# =============================================================================
CHAT_ENABLED=true

# Answer common questions from assessment data with ZERO tokens — "what should I
# do", "how sure are you", "why did you send this". Those answers are already
# computed by the pipeline; paraphrasing them through a model would spend tokens
# AND introduce the step at which a figure could get invented.
#
# This is the single biggest cost saving in the stack. Check the hit rate with
# GET /chat/economics — a low `zero_token_share` means the phrase list in
# app/chat/answers.py is not matching how your subscribers actually ask.
#
# Works with NO inference endpoint configured.
CHAT_DETERMINISTIC_ANSWERS=true

# Prior turns RETRIEVED BY RELEVANCE and sent as context (needs embeddings).
# Smaller than a recency window because retrieval returns the turns that matter:
# 6 relevant turns beat 12 mostly-irrelevant ones at half the tokens. Without
# embeddings this falls back to the 6 most recent.
CHAT_CONTEXT_TURNS=6

# Turns returned by GET /chat/{id}/history for DISPLAY. Unrelated to what is sent
# to the model — raising this costs nothing.
CHAT_HISTORY_TURNS=40

CHAT_MAX_TOOL_ROUNDS=3
CHAT_SEARCH_MAX_RESULTS=5

# Cache identical questions within a session. Subscribers re-ask, especially on
# poor connections where they cannot tell whether the first message sent. 0 off.
CHAT_CACHE_TTL_SECONDS=1800

# Bounds request RATE. The token budget below bounds COST — both are needed.
CHAT_RATE_LIMIT_PER_HOUR=60


# =============================================================================
# EMBEDDINGS — same OpenAI-compatible transport (/v1/embeddings)
#
# Optional. Powers chat memory retrieval: instead of replaying the last N turns
# on every question, retrieve the K most relevant. Costs a constant instead of
# growing linearly with conversation length.
#
# Blank inherits LLM_BASE_URL / LLM_API_KEY, so setting the chat provider alone
# usually enables this too. A separate URL is supported because the economical
# setup is a tiny local embedding model beside a frontier chat model:
#
#   EMBEDDING_BASE_URL=http://localhost:8080/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768        # in the POSTGRESQL section above
#
# EMBEDDING_DIMENSIONS must match the model's output width, and it is DDL — the
# pgvector column type carries it, so changing it needs a migration.
# =============================================================================
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_INPUT_CHARS=8000


# =============================================================================
# TOKEN BUDGET
#
# An always-on service across thousands of subscribers can spend without bound if
# nothing counts. Two daily ceilings, both self-expiring at UTC midnight.
#
# BOTH FAIL OPEN by default: if the counter is unreachable we cannot know the
# spend, and refusing to explain a flood warning because a Redis key is missing is
# the worse failure. Set LLM_BUDGET_FAIL_CLOSED=true for a hard cost cap.
#
# NEITHER gates advisory generation. Advisories are the product — they degrade to
# English templates on their own if a provider is unavailable, and a budget must
# never be the reason a farmer gets no warning. Only chat and Fahis are gated.
# =============================================================================
LLM_BUDGET_ENABLED=true

# 0 disables an individual ceiling.
LLM_DAILY_TOKEN_BUDGET_PER_SUBSCRIBER=50000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=5000000

LLM_BUDGET_FAIL_CLOSED=false


# =============================================================================
# AUTONOMOUS WATCH LOOP
#
# Run this in exactly ONE process. It is enabled on the API container and
# disabled on the workers; if you scale the API past one replica, disable it
# there too and run a single dedicated scheduler.
# =============================================================================
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=21600
SCHEDULER_JITTER_SECONDS=300

# How often the loop repairs monitored areas that carry no billing attribution,
# in hours. Attribution is written when an area is created; this only catches the
# paths that could not — a transient Mongo failure, or an area predating the
# feature. Those areas are monitored but unbillable, and nothing else reports it.
#
# Daily rather than every cycle: the sweep walks every area, and at 6-hourly it
# would spend that work almost entirely on areas already correct. Set 0 to
# disable and run it from cron instead.
ATTRIBUTION_RECONCILE_HOURS=24

# Per-AREA hourly cap on partner-triggered scans
# (POST /customers/{id}/areas/{aoi}/scan, scope `scan:trigger`).
#
# The one Partner API call that spends real satellite catalogue quota on demand,
# and it costs the same whether or not the answer can have changed. Sentinel-1
# revisits West Africa about every 6 days, so an integration looping over a
# customer list every minute would re-read one scene hundreds of times for an
# identical answer — a self-inflicted denial of service against the free
# upstreams every deployment shares.
#
# Per area, not per key: the cost is per footprint, and a per-key cap would let
# one aggregator with many customers starve the queue while a small one is
# throttled over a single plot. 4/hour is above the revisit rate it can usefully
# observe and still leaves room to retry after a transient failure.
SCAN_TRIGGER_RATE_LIMIT_PER_HOUR=4

# =============================================================================
# IAM — identity, onboarding and API keys (MongoDB Atlas)
#
# Deliberately a separate datastore from Postgres. The reason is blast radius: a
# read-replica grant, an analytics user or a pg_dump on the operational database
# exposes assessments and subscriber addresses. Putting password hashes and API-key
# hashes there would extend every one of those grants to credentials. Separate stores
# mean a Postgres compromise cannot authenticate as anyone.
#
# UNSET IS A VALID STATE. Without MONGO_URL the /iam/* endpoints return 503 and the
# satellite pipeline is completely unaffected — identity is an onboarding surface, not
# something a flood warning depends on.
# =============================================================================
# Identity identifiers (aggregator_id, subscriber_id) are 10-character alphanumerics
# minted by the IAM service, e.g. A7K2M9P4QX. They exclude I, O, 0 and 1 because those
# are confused when read aloud or handwritten — and these are the ids a partner stores,
# a farmer quotes on a support call, and an agent types from a note. Uniqueness is
# guaranteed by unique indexes on accounts.id and subscribers.id, with a pre-insert
# retry so a collision never reaches a user.
#
# An id is NOT a credential: authorisation is the API key plus the membership edge, so
# guessing an id gains nothing — a request for another tenant's subscriber returns 404.
MONGO_URL=
MONGO_DATABASE=shelter_iam
# Server-selection timeout. Short on purpose: a signup must fail fast with a clear
# error rather than hanging a browser for 30 seconds on a bad URI.
MONGO_TIMEOUT_MS=5000

# Signing secret for portal session tokens (JWT, HS256). Falls back to API_KEY for
# local work; preflight makes it a HARD ERROR in production, because a predictable
# signing key lets anyone mint a session for any account.
#   openssl rand -hex 32
IAM_JWT_SECRET=
# Portal session lifetime. 12 hours: a working day without re-login, short enough that
# a token copied from a shared device expires.
#
# This is the ABSOLUTE ceiling. IAM_IDLE_TIMEOUT_MINUTES below is what normally ends a
# session — the two answer different questions ("how long may a session ever live" vs
# "how long may it sit unattended").
IAM_SESSION_MINUTES=720

# Idle window. A session with no REAL USER ACTIVITY for this long is refused server-side,
# regardless of the JWT's own expiry — so a stolen cookie dies in 15 minutes rather than
# lasting the full 12 hours.
#
# "Real activity" means pointer, keyboard, scroll, touch or tab focus, reported by the
# browser to POST /iam/session/activity. Request traffic alone does NOT count: the
# dashboard polls its own status endpoint, and if that refreshed the window an unattended
# open tab would stay signed in forever.
#
# Last-seen timestamps live in Dragonfly db1 under `iam:idle:<jti>`, with the window as
# the key's own TTL — so an abandoned session cleans itself up and there is no sweep job.
# If the cache is unreachable the check FAILS OPEN and falls back to the absolute expiry
# above: logging every subscriber out of a hazard dashboard over a cache blip is the worse
# failure.
IAM_IDLE_TIMEOUT_MINUTES=15
# How long before idle expiry the browser starts its countdown modal. 120s is enough to
# notice it, walk back and dismiss it, without being so long the warning becomes furniture.
IAM_IDLE_WARNING_SECONDS=120

# Login throttling, keyed on EMAIL not IP — farmers in one district share a NAT, so
# IP-based lockout would let one attacker lock out a whole village. Argon2 costs ~50ms
# per attempt; this stops that cost being turned back on us as a denial of service.
IAM_MAX_LOGIN_ATTEMPTS=8
IAM_LOGIN_LOCKOUT_MINUTES=15

# How long an email-confirmation link stays valid.

# ---------------------------------------------------------------------------
# Breached-password screening (Have I Been Pwned)
# ---------------------------------------------------------------------------
# Blocks passwords known to be exposed in public breaches, at signup and at
# password reset. Not applied to LOGIN — locking someone out of their own flood
# warnings because an old password later appeared in a breach is the wrong trade;
# the right response is to prompt a change once they are safely inside.
#
# THE PASSWORD NEVER LEAVES THIS PROCESS. The k-anonymity protocol sends only the
# first FIVE characters of the SHA-1 hash; HIBP returns every suffix under that
# prefix (~300-900 of them) and the match happens locally. HIBP never sees the
# password, the full hash, the account, or whether a match occurred.
#
# SHA-1 here is not a security choice — it is the index HIBP publishes. Stored
# passwords use Argon2id and are unaffected.
#
# FAILS OPEN: unreachable or slow means "not breached". A false negative lets one
# reused password through, bounded by the 12-char minimum and Argon2id. A false
# positive would block a farmer from registering for flood warnings over an
# outage they cannot see — the worse failure.
HIBP_ENABLED=true
HIBP_RANGE_URL=https://api.pwnedpasswords.com/range
# Short: this sits in the request path of a signup form.
HIBP_TIMEOUT_SECONDS=3.0
# Prefix buckets are public ranges shared by ~1-in-a-million hashes, so caching
# them leaks nothing about any account.
HIBP_CACHE_TTL_SECONDS=86400
IAM_VERIFICATION_TTL_HOURS=48

# Path to an MMDB city database. Turns an audit entry's IP into
# "Warrington, United Kingdom" in the portal's activity log and session panel.

# ---------------------------------------------------------------------------
# Place search (Nominatim / OpenStreetMap)
# ---------------------------------------------------------------------------
# Powers "where is Argungu?" on the AOI picker, and reverse-geocodes a dropped pin
# into country / state / LGA so a partner posting {lat, lon} gets those fields
# filled without knowing Nigerian administrative structure.
#
# Proxied through the backend rather than called from the browser: every query
# names a district and belongs to someone setting up monitoring for their own farm,
# and the 1 req/sec policy is per-IP, so search-as-you-type from a browser would be
# throttled instantly.
#
# ATTRIBUTION IS A LICENCE CONDITION. The data is ODbL, so "© OpenStreetMap
# contributors" must appear wherever results are shown. The API returns it in every
# response body (`attribution`) so a client cannot omit it by not reading the docs.
#
# Degrades to an empty result list on any failure — a subscriber who cannot search
# can still drop a pin or use GPS, which are more accurate anyway.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# One request per second, enforced process-wide. Going faster earns a block for the
# whole deployment, not just one user.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# Short: this sits in a type-ahead path and must degrade rather than hang.
NOMINATIM_TIMEOUT_SECONDS=4.0
# Long: place names do not move, and this is what keeps a busy deployment inside
# the usage policy. 7 days.
NOMINATIM_CACHE_TTL_SECONDS=604800

# =============================================================================
# TYPE-AHEAD — Photon (OpenStreetMap prefix index), SELF-HOSTED
#
# Nominatim above is a FULL-TEXT geocoder: it resolves "Argungu, Kebbi" well and
# the prefix "Argun" poorly, and its 1 req/sec policy forbids a request per
# keystroke on arithmetic alone. Photon is a prefix index over the same OSM data,
# built for search-as-you-type, answering in single-digit milliseconds.
#
# SELF-HOSTED IS NOT OPTIONAL. Measured against the public instance at
# photon.komoot.io: 23 SECONDS for one query. Behind a keystroke that is not a slow
# feature, it is a broken one. Same reasoning as SearXNG and MinIO — and the privacy
# argument is sharper here, because a suggestion stream is a character-by-character
# record of someone typing their own address.
#
# EMPTY DISABLES THE FEATURE. The UI falls back to the debounced Nominatim search
# and `GET /places/suggest` returns `available: false` so a client can tell "switched
# off" from "no matches". That is what makes this shippable before the container
# exists — a deployment without Photon has clumsier search, not a broken form.
#
# Attribution is identical to Nominatim's: same ODbL data, same licence condition.
# =============================================================================
PHOTON_URL=
# Very short — this is on the keystroke path. A slow suggestion is worse than none,
# because the user has already typed past it. Photon answers a local index in ~10ms,
# so anything near this ceiling means the service is unhealthy.
PHOTON_TIMEOUT_SECONDS=1.5
# 1 day. Shorter than Nominatim's week because a prefix index is rebuilt on each OSM
# import. "Kan" is a prefix of every Kano query on the platform, so this earns its keep.
PHOTON_CACHE_TTL_SECONDS=86400
# Ten is already more than a phone screen can show.
PHOTON_MAX_RESULTS=8
# Suggestion requests per credential per hour; 0 disables the ceiling.
#
# Deliberately high — a subscriber outlining three plots may legitimately type a few
# hundred characters. The limit exists to stop a valid key walking the alphabet to
# harvest Nigeria's address graph (a licence and reputational problem even though OSM
# data is public), not to ration typing. Keyed on the credential, so the portal's whole
# subscriber base shares one bucket while each aggregator gets its own.
PLACE_SUGGEST_RATE_LIMIT_PER_HOUR=2000

# =============================================================================
# VECTOR / GeoParquet — Overture Maps (keyless, ODbL + CDLA-Permissive)
#
# The first VECTOR source in the platform. Every other reader in app/eo/ reads
# rasters; this reads columnar feature data (one row per business or building) with
# DuckDB + httpfs, IN PLACE over HTTP range reads.
#
# Not copied into our own object store on purpose: that would add a multi-gigabyte
# sync job and a staleness question against a monthly release, to speed up queries
# that already finish in seconds. Parquet row-group statistics make a bbox filter
# read only the row groups that overlap the AOI — the same bargain cog.py makes.
#
# DuckDB is an OPTIONAL dependency. Empty URL, or duckdb not installed, disables
# every vector read with one debug line. Nothing in the hazard path depends on it.
#
# WHAT IS ACTUALLY THERE, measured 2026-08-12 (this changed the plan):
#   theme=places      53,865 POIs over a Lagos bbox, with categories/phones. USABLE.
#   theme=buildings   1.2M footprints, but only 0.19% carry a height and 0.07% a
#                     name. Geometry only. ~110s per AOI, so NOT on a request path.
#   theme=addresses   ZERO in Africa. Covers 39 countries, none of them African.
#                     Overture CANNOT verify a Nigerian address — Nominatim
#                     structured search plus the polygon outline is what does that.
# =============================================================================
OVERTURE_RELEASE_URL=s3://overturemaps-us-west-2/release/2026-07-22.0
# The bucket's region. A wrong value fails every read with a redirect error.
OVERTURE_S3_REGION=us-west-2
# Per-query ceiling. 30s against a measured 12s for a places query over one AOI —
# headroom for a slower link without letting a stalled public bucket extend a scan.
OVERTURE_QUERY_TIMEOUT_SECONDS=30.0
#
# OPTIONAL and absent by default — the file is gitignored and not in the image.
# `app/iam/geo.py` degrades to showing the raw IP rather than failing, the same
# discipline as the ML weights falling back to documented physical thresholds.
#
# Self-hosted rather than an IP-geolocation API on purpose: every lookup is a
# subscriber's IP, and this subscriber list is farmers in named districts. Those
# addresses must not leave the deployment.
#
# To enable:  make geoip
#
# That fetches DB-IP City Lite (CC-BY 4.0) — no account and no licence key, which is
# why it is the default. MaxMind GeoLite2 works too and is slightly more accurate, but
# needs a signup: MAXMIND_LICENCE_KEY=xxx make geoip-maxmind. Either lands at the path
# below, so the app needs no change to swap them.
#
# Accuracy caveat: free city resolution in Sub-Saharan Africa is materially worse
# than in Europe — often the carrier's national gateway rather than the subscriber's
# town. The API returns a `confidence` field and the UI says "From your IP address"
# rather than asserting the city as fact.
GEOIP_DATABASE_PATH=/app/data/city.mmdb

# --- API key governance (commercial aggregators only) ------------------------
# Keys are shown ONCE at creation, stored only as a SHA-256 hash, and cannot be
# recovered by anyone including support — that is arithmetic, not policy.
#
# Live keys per account. Bounded so a compromised portal session cannot mint thousands
# before anyone notices.
#
# Key format: `shltky` + 52 random chars + 6-char CRC32 = 64 characters exactly.
# Test keys use `shlttk` and are the same length, so a length check cannot reveal
# which environment a key belongs to. The body is drawn from alphanumerics plus
# `-._~` — RFC 3986's unreserved set, so a key survives a URL, a shell command, a
# YAML file and an HTTP header unescaped. base64's `+/=` and shell-active characters
# are deliberately excluded.
IAM_MAX_API_KEYS_PER_ACCOUNT=10
# Days of inactivity before a key is flagged `stale` in the portal. An unused live key
# is pure liability: nothing breaks when it is revoked.
IAM_KEY_STALE_DAYS=90
# How far ahead an expiring key is flagged, so a partner is warned before the outage
# rather than by it.
IAM_KEY_EXPIRY_WARNING_DAYS=14
# Hours a rotated key keeps working. Lets a partner deploy the replacement before the
# old one dies — without a grace window, rotation means choosing between an outage and
# leaving a compromised key live, and people choose to leave it live. Set 0 per-request
# on the rotate call when a key has actually leaked.
IAM_KEY_ROTATION_GRACE_HOURS=24
# Per-key audit retention (created/used/rotated/revoked/rejected).
IAM_KEY_AUDIT_RETENTION_DAYS=180

# --- Immutable audit log -----------------------------------------------------
# Append-only: there is no update or delete path in app/iam/store.py, and a test
# asserts that structurally. Every event is its OWN document, so the 16 MB BSON limit
# is unreachable — the way audit logs hit that cap is by being an array inside a parent
# document. Retention below is enforced by a Mongo TTL index, i.e. deletion by database
# policy on Mongo's schedule, which is not an application code path.
#
# 730 days = 2 years: long enough for an insurance or regulatory review. Stamped at
# insert, so it cannot be shortened retroactively for entries already written.
IAM_AUDIT_RETENTION_DAYS=730

# --- Passwordless and second-factor sign-in ----------------------------------
# Magic-link sign-in: an emailed single-use link, no password to remember. The primary
# path for individuals, who may share a handset and be on a metered connection — a
# forgotten password there is a support call, not a self-service reset. Needs a working
# email transport; with none the endpoint returns 503 rather than a button that
# silently does nothing.
IAM_MAGIC_LINK_ENABLED=true

# Offer TOTP (RFC 6238) as a second factor. Chosen over SMS codes: SIM swap is a live
# fraud pattern in the launch market, and TOTP costs nothing per authentication.
IAM_TOTP_ENABLED=true

# Require TOTP for commercial accounts once enrolled. Off by default so enrolling is not
# a one-way door before an operator has stored their recovery codes. Never applies to
# individuals: mandatory 2FA on a farmer with one handset and no authenticator app locks
# them out of their own flood warnings.
IAM_TOTP_REQUIRED_FOR_COMMERCIAL=false

# --- Migrating off the shared X-SHELTER-Key ----------------------------------
# API_KEY above is a single static string that gated 29 write endpoints across seven
# routers with NO attribution, NO scoping, and no way to revoke one consumer without
# revoking all of them. For a SaaS platform that is the wrong shape: a leak from
# Netlify's environment, CI, or any developer's .env is a leak of full broadcast
# authority.
#
# It is replaced by SERVICE ACCOUNTS holding scoped keys, with the same lifecycle as
# aggregator keys — show-once, hashed at rest, rotatable with a grace window,
# revocable immediately, individually auditable.
#
#   1. Provision one:  make iam-service-account NAME=netlify-frontend EMAIL=ops@you.co
#   2. Put the printed key in the frontend as SHELTER_API_KEY
#   3. The frontend sends it as X-SHELTER-API-Key (lib/api.ts sends both during
#      migration, so nothing breaks mid-cutover)
#   4. Set this false, then delete API_KEY
#
# The frontend's key gets platform:subscribers:write + platform:read +
# platform:assess. It deliberately does NOT get platform:broadcast — the portal has
# no reason to page a district, though the old shared key allowed exactly that.
#
# true keeps the deprecated header working during migration. It is refused in
# production regardless once MONGO_URL is set, because at that point a scoped key is
# available and the shared key is strictly worse.
IAM_LEGACY_SHARED_KEY_ENABLED=true
